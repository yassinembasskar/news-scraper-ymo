FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN playwright install --with-deps chromium

# Bake the embedding model into the image at build time, so the backend
# never needs network access to huggingface.co at runtime (matches
# HF_HUB_OFFLINE=1) and doesn't depend on this being any particular
# deployment environment with outbound internet.
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('Qwen/Qwen3-Embedding-0.6B')"

COPY app/ ./app/

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]